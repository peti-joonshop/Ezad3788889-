# DirectAdmin production environment for (Mooooobadel*&_-__----💰)
# Copy this file to .env and replace every placeholder before starting the app.

NODE_ENV=production
# DirectAdmin/Passenger usually provides PORT. Keep this fallback for manual starts.
PORT=3000

# Used by docker-compose.production.yml on a VPS. Use strong unique passwords.
MYSQL_DATABASE=tablojadoo
MYSQL_USER=tablojadoo
MYSQL_PASSWORD=replace_with_a_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_root_password
APP_PORT=3000

# MySQL/MariaDB connection used by Drizzle ORM and the application.
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/DB_NAME

# Manus OAuth integration (required by the current login implementation).
# These values keep Google/email login working after moving the server to DirectAdmin.
MANUS_PROJECT_ID=replace_with_manus_project_id
MANUS_JWT_SECRET=replace_with_a_long_random_secret
MANUS_OAUTH_API_URL=https://api.manus.ai
MANUS_OAUTH_PORTAL_URL=https://manus.im

# Optional: leave empty for the safer host-only cookie on tablojadoo.ir.
# Set to .tablojadoo.ir only when the session must be shared with a subdomain.
COOKIE_DOMAIN=

# Manus API/LLM integration used by the sales assistant and optional platform helpers.
# Leave MANUS_API_KEY empty only if local fallback replies are acceptable.
MANUS_API_URL=https://forge.manus.ai
MANUS_API_KEY=replace_with_manus_api_key
# Browser-safe key, only if a feature that uses it is enabled.
MANUS_API_BROWSER_KEY=

# Optional owner mapping. Leave empty unless an owner OpenID is known.
OWNER_OPEN_ID=

# Optional channel integrations. Leave empty when not configured.
KAVENEGAR_API_KEY=
WHATSAPP_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
